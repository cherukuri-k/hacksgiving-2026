# All variables are optional. Without them Relay MKE runs fully in demo mode:
# in-memory store, rule-based AI, mock SMS.

# LLM for intake structuring, call summaries, funder narrative, Field Guide Q&A.
# Set either provider; Anthropic is preferred when both are present. Falls back to rules if neither is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# OpenAI is also the only provider for Whisper (voice notes on /r).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase (persistent store). Falls back to in-memory seed data if unset.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Twilio (real SMS). Falls back to mock SMS + /api/sms/simulate if unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Phone line — ElevenLabs agent (see README "Phone line"). All optional.
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=          # from Agents → Settings → Post-call webhooks
VOICE_TOOL_SECRET=                  # any random string; sent by the agent as x-relay-secret
PUBLIC_BASE_URL=                    # https tunnel to this app, e.g. https://xxx.trycloudflare.com
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=    # printed by tools/voice/create-agent.mjs; enables the web-call widget on /r
NEXT_PUBLIC_RELAY_PHONE=            # e.g. (414) 555-0100 — shows a "Call Relay" button on /r
VOICE_NOTICE=                       # robotic pre-roll; default: "This call is answered by ComForce Milwaukee's Relay line and may be recorded. Please hold."
ELEVENLABS_TWILIO_INBOUND_URL=      # the voice URL ElevenLabs sets on your Twilio number after import

# Partner dispatch (Jordan calls + emails the partner). All optional; without them the call is simulated automatically (ring → pickup → scripted conversation → accepted) and email is mocked.
NEXT_PUBLIC_ELEVENLABS_DISPATCH_AGENT_ID=   # second agent printed by tools/voice/create-agent.mjs (only used for real outbound calls)
DISPATCH_SIM_RING_MS=2500                   # simulated call: how long the partner line rings
DISPATCH_SIM_TURN_MS=1700                   # simulated call: delay between conversation turns
FOLLOWUP_SMS_WAIT_MS=15000                  # after 'delivered': how long to wait for a text reply before Jordan calls the resident back
NEXT_PUBLIC_ELEVENLABS_FOLLOWUP_AGENT_ID=   # third agent from create-agent.mjs. When set, Jordan's call-back rings /phone and runs as a LIVE voice call (unset = scripted simulation)
FOLLOWUP_RING_TIMEOUT_MS=45000              # live call-back: how long the phone rings before it's logged as no answer
ELEVENLABS_DISPATCH_AGENT_ID=               # same id, server side (used to route the post-call webhook)
ELEVENLABS_PHONE_NUMBER_ID=                 # imported Twilio number in ElevenLabs → enables real outbound calls to partners
RESEND_API_KEY=                             # real email via Resend; otherwise mocked and shown on /partner-line
EMAIL_FROM=                                 # e.g. "Relay MKE <relay@yourdomain>"
NEXT_PUBLIC_BASE_URL=                       # public URL used for the QR code on /route/[id]
RELAY_PLANNER=                              # how draft tasks are written. Unset = hybrid when a model key is set, otherwise local.
                                            #   local  = on-disk planner in lib/planner, no API key, no network
                                            #   hybrid = local planner drafts, then the hosted model tailors the wording (one call per ticket)
                                            #   claude = hosted model only
